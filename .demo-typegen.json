{
  "schemaVersion": 1,
  "sdk": [],
  "studios": [
    {
      "directory": "apps/studio",
      "enforceRequiredFields": true,
      "output": "apps/studio/schema.json",
      "workspace": null
    }
  ],
  "web": [
    {
      "config": "apps/web/sanity.cli.ts",
      "directory": "apps/web",
      "output": "apps/web/src/lib/sanity/sanity.types.ts",
      "paths": ["src/**/*.{ts,tsx,js,jsx}"],
      "schema": "apps/studio/schema.json"
    }
  ]
}
